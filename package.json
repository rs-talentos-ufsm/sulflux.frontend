{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format-check": "prettier --check .",
    "format-fix": "prettier --write .",
    "lint-check": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepare": "husky",
    "test": "vitest run",
    "dev-upd": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development up --build -d",
    "dev-up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development up",
    "dev-down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development down",
    "dev-reset": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development down -v",
    "prod-up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production up --build -d",
    "prod-down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production down",
    "prod-reset": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production down -v",
    "log": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development logs -f frontend"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@lib/shared": "git+https://github.com/dorneles-laboratory/pgi-proa.shared.git#main",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.90.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.13.2",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.9.6",
    "sonner": "^2.0.7",
    "zod": "4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
